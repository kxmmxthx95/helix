VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: enables the map picker on the student address tab (Maps JavaScript API).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: school LINE OA add-friend link, shows an "เปิด LINE OA" button in the link-account card.
VITE_LINE_OA_URL=
# Web push public key (pair with VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT secrets on the line-notify function; npx web-push generate-vapid-keys). Empty = push toggle disabled.
VITE_VAPID_PUBLIC_KEY=
# Cloudflare files-worker (docs/cloudflare-migration.md phase 2). Buckets listed in VITE_R2_BUCKETS are served from R2; the rest stay on Supabase Storage.
VITE_STORAGE_URL=
VITE_R2_BUCKETS=
# API worker (same worker as VITE_STORAGE_URL today). Used by src/lib/db.ts, which nothing imports yet.
VITE_API_URL=
